# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_MODEL=

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: local_lsa | chroma_onnx | sentence_transformers
EMBEDDING_PROVIDER=local_lsa
EMBEDDING_MODEL=local/tfidf-lsa-v1
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32

# Optional services
PAGEINDEX_API_KEY=
PAGEINDEX_HTTP_TIMEOUT=30
PAGEINDEX_POLL_TIMEOUT=90
PAGEINDEX_POLL_INTERVAL=1
PAGEINDEX_MAX_WORKERS=4
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=
